{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "youareup",
          "appId": "1:181795819212:android:09d7a3388cfd33e5bbfc69",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "youareup",
          "appId": "1:181795819212:ios:aa5ce674bc508ff6bbfc69",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/GoogleService-Info.plist"
        },
        "buildConfigurations": {
          "Debug": {
            "projectId": "youareup",
            "appId": "1:181795819212:ios:aa5ce674bc508ff6bbfc69",
            "uploadDebugSymbols": false,
            "fileOutput": "ios/GoogleService-Info.plist"
          }
        }
      },
      "dart": {
        "lib/services/firebase_options.dart": {
          "projectId": "youareup",
          "configurations": {
            "android": "1:181795819212:android:09d7a3388cfd33e5bbfc69",
            "ios": "1:181795819212:ios:aa5ce674bc508ff6bbfc69",
            "web": "1:181795819212:web:24768b6eb4209f64bbfc69"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.DS_Store"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/support",
        "destination": "/support.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": false,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Barajando",
        "supportEmail": "samirrodriguez14@gmail.com"
      }
    }
  }
}
