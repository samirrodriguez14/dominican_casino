rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // FCM tokens and profile — never on game docs.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'fcmToken',
          'fcmTokens',
          'displayName',
          'name',
          'avatarId',
          'completedTutorial',
          'updatedAt',
          'coins',
          'energy',
          'energyUpdatedAt',
          'energyFullAt',
          'locale',
          'lastDailyClaimAt',
          'dailyChallenges',
          'ownedPacks',
          'appTheme',
          'cardBack',
          'cardBackMark',
          'cardBackTint',
          'activeGameId',
        ]);
      allow delete: if isSelf(uid);

      // Lightweight lobby rows — not full match state.
      match /activeGames/{gid} {
        allow read, write: if isSelf(uid);
      }
      match /archivedGames/{gid} {
        allow read, write: if isSelf(uid);
      }
      match /opponentStats/{opponentUid} {
        allow read, write: if isSelf(uid);
      }
    }

    // Leaderboard-safe profile fields (no FCM / wallet secrets).
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'name',
          'avatarId',
          'wins',
          'league',
          'leagueExitRanks',
          'updatedAt',
        ]);
      allow delete: if isSelf(uid);
    }

    // Match documents. Authenticated clients may still write full state
    // until server-side applyMove ships — but anonymous guests cannot.
    match /games/{gid} {
      allow create: if signedIn()
        && request.resource.data.controllerId == request.auth.uid;
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn()
        && resource.data.controllerId == request.auth.uid;

      match /signals/{sid} {
        allow read, write: if signedIn();
      }
    }

    // Quick Match queue — clients enqueue/cancel; matcher CF claims matches.
    match /matchmakingQueue/{uid} {
      allow read: if isSelf(uid);
      allow delete: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'waiting'
        && !('matchedGameId' in request.resource.data);
      allow update: if isSelf(uid)
        && (
          (request.resource.data.status == 'waiting'
            && !('matchedGameId' in request.resource.data))
          || request.resource.data.status == 'cancelled'
        );
    }
  }
}
