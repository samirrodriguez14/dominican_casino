{
    "title": "How to Play",
    "sections": [
        {
            "title": "General Info",
            "description": "A capture card game, but don't run out of time.",
            "facts": [
                {"label": "Time", "value": "2–5 min"},
                {"label": "Players", "value": "2"},
                {"label": "Win condition", "value": "Highest score after 1 round"},
                {"label": "Tie-break", "value": "Most coins, else another round"}
            ]
        },
        {
            "title": "Cards",
            "showCardsFirst": true,
            "body": [
                "Number cards use their face value.",
                "An Ace can capture another Ace, or any group that adds to 14."
            ],
            "specialCards": [
                {
                    "rank": "K",
                    "suit": "♠",
