                    "points": "Q = 12"
                },
                {
                    "rank": "J",
                    "suit": "♣",
                    "label": "Jack",
                    "points": "J = 11"
                },
                {
                    "rank": "A",
                    "suit": "♦",
                    "label": "Ace",
                    "points": "A = 1 or 14"
                }
            ]
        },
        {
            "title": "Game Rules",
            "body": [
                "On your turn, play one card from your hand.",
                "If the card matches a card or stack value on the table, it can capture them.",
                "Cards can also be combined into stacks.",
                "Stacks can only be captured by a card matching the stack value."
            ]
        },
        {
            "title": "Scoring",
            "facts": [
                {"label": "Most cards", "value": "+3 carta"},
                {"label": "Most spades", "value": "+1 pi"},
                {"label": "Each Ace", "value": "+1"},
                {"label": "2♠", "value": "+1"},
                {"label": "10♦", "value": "+2"},
                {"label": "Viraos", "value": "Added separately"}
            ],
            "specialCards": [
                {
                    "rank": "A",
                    "suit": "♠",
                    "label": "Ace",
                    "points": "+1 each"
                },
                {
                    "rank": "2",
                    "suit": "♠",
                    "label": "Two of Spades",
                    "points": "+1"
                },
                {
                    "rank": "10",
                    "suit": "♦",
                    "label": "Ten of Diamonds",
                    "points": "+2"
                }
            ]
        },
        {
            "title": "Coins",
            "facts": [
                {"label": "Take 6+", "value": "Coins = cards taken"},
                {"label": "Specials", "value": "Pay on capture"},
                {"label": "Viraos", "value": "Extra coins at round end"},
                {"label": "Score tie", "value": "Most coins wins"}
            ],
            "specialCards": [
