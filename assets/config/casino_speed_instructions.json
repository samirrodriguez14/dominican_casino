                    "points": "+1 coin"
                },
                {
                    "rank": "10",
                    "suit": "♦",
                    "label": "Ten of Diamonds",
                    "points": "+2 coins"
                }
            ]
        },
        {
            "title": "Winning",
            "body": [
                "After one full round, the player with the most points wins the match.",
                "If points are tied, the player with more coins awarded that round wins.",
                "If coins are also tied, deal another round and repeat until someone wins."
            ]
        }
